# URL de la API. En desarrollo no hace falta: Vite redirige /api al backend
# en localhost:4000 (ver vite.config.js). En producción (Vercel) debe ser la
# URL pública de la API, terminada en /api.
# VITE_API_URL="https://ritmoapp-api.onrender.com/api"

# Muestra en el login los accesos de un clic a las cuentas de demostración.
# Solo para la demo pública.
# VITE_MODO_DEMO="true"
