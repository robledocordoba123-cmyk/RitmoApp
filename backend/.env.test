# Variables de entorno para correr los tests (npm test). Base de datos
# separada de la de desarrollo, para que las pruebas puedan borrar y
# recrear datos sin afectar lo que estés probando a mano.

DATABASE_URL="postgresql://ritmoapp:ritmoapp_dev@localhost:5432/ritmoapp_test?schema=public"
JWT_SECRET="secreto-de-pruebas"
JWT_EXPIRES_IN="1h"
