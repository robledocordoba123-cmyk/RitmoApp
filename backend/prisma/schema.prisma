// Esquema de RitmoApp: SaaS multi-tenant para academias de baile.
// Cada tabla de negocio lleva tenantId obligatorio (RNF-01, RN-04): el aislamiento
// entre academias se hace por columna + middleware, no por base de datos separada.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// La URL de conexión ya no va aquí en Prisma 7: se define en prisma.config.cjs
// (para el CLI) y se pasa como adapter al construir PrismaClient (para la app).
datasource db {
  provider = "postgresql"
}

enum Rol {
  SUPERADMIN
  ADMIN_ACADEMIA
  PROFESOR
  ESTUDIANTE
}

enum EstadoTenant {
  ACTIVA
  SUSPENDIDA
}

enum EstadoClase {
  PROGRAMADA
  CANCELADA
  FINALIZADA
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
}

enum EstadoAsistencia {
  ASISTIO
  INASISTENCIA
  EXCUSA
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

// Academia de baile (tenant). RF-01.
model Tenant {
  id        String       @id @default(uuid())
  nombre    String
  nit       String       @unique
  estado    EstadoTenant @default(ACTIVA)
  createdAt DateTime     @default(now())

  usuarios  User[]
  salones   Salon[]
  ritmos    Ritmo[]
  clases    Clase[]
  reservas  Reserva[]
  asistencias Asistencia[]
  tarifas   Tarifa[]
  pagos     Pago[]

  @@map("tenants")
}

// Usuario de cualquier rol. tenantId es null solo para SUPERADMIN (RF-02, RF-03).
model User {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  clasesComoProfesor Clase[]      @relation("ProfesorClases")
  reservas            Reserva[]
  asistenciasRegistradas Asistencia[] @relation("AsistenciaRegistradaPor")
  asistenciasComoEstudiante Asistencia[] @relation("AsistenciaEstudiante")
  pagos               Pago[]       @relation("PagosEstudiante")
  pagosRegistrados    Pago[]       @relation("PagosRegistradosPor")
  tokensRecuperacion  TokenRecuperacion[]

  @@index([tenantId])
  @@map("users")
}

// Salón físico de una academia. RF-04.
model Salon {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  nombre    String
  capacidad Int
  activo    Boolean @default(true)

  clases Clase[]

  @@index([tenantId])
  @@map("salones")
}

// Estilo de baile ofrecido por una academia. RF-04.
model Ritmo {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  nombre   String

  clases Clase[]

  @@index([tenantId])
  @@map("ritmos")
}

// Clase programada: combina salón, ritmo y profesor en una franja horaria.
// RF-05, RN-02 (salón sin cruce) y RN-03 (profesor sin cruce) se validan en el
// servicio, no aquí, porque dependen de comparar rangos de fecha/hora.
model Clase {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  ritmoId        String
  ritmo          Ritmo       @relation(fields: [ritmoId], references: [id])
  salonId        String
  salon          Salon       @relation(fields: [salonId], references: [id])
  profesorId     String
  profesor       User        @relation("ProfesorClases", fields: [profesorId], references: [id])
  cupoMaximo     Int
  // Contador que se decrementa de forma atómica al reservar (RN-01, RNF-02):
  // evita el overbooking del último cupo sin necesidad de bloqueos manuales.
  cuposDisponibles Int
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime
  estado         EstadoClase @default(PROGRAMADA)
  createdAt      DateTime    @default(now())

  reservas    Reserva[]
  asistencias Asistencia[]

  @@index([tenantId])
  @@index([salonId, fechaHoraInicio, fechaHoraFin])
  @@index([profesorId, fechaHoraInicio, fechaHoraFin])
  @@map("clases")
}

// Reserva de cupo de un estudiante. RF-06, RN-01 (cupo), RN-04 (aislamiento).
// La unicidad (claseId, estudianteId) evita que el mismo estudiante reserve dos
// veces la misma clase; el límite de cupo se valida en una transacción del servicio.
model Reserva {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  claseId      String
  clase        Clase         @relation(fields: [claseId], references: [id])
  estudianteId String
  estudiante   User          @relation(fields: [estudianteId], references: [id])
  estado       EstadoReserva @default(CONFIRMADA)
  createdAt    DateTime      @default(now())

  @@unique([claseId, estudianteId])
  @@index([tenantId])
  @@map("reservas")
}

// Registro de asistencia por clase y estudiante. RF-07.
model Asistencia {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  claseId          String
  clase            Clase            @relation(fields: [claseId], references: [id])
  estudianteId     String
  estudiante       User             @relation("AsistenciaEstudiante", fields: [estudianteId], references: [id])
  estado           EstadoAsistencia
  registradoPorId  String
  registradoPor    User             @relation("AsistenciaRegistradaPor", fields: [registradoPorId], references: [id])
  registradoEn     DateTime         @default(now())

  @@unique([claseId, estudianteId])
  @@index([tenantId])
  @@map("asistencias")
}

// Plan que vende la academia (mensualidad, tiquetera, etc.). RF-18 · HU-18.
// El valor se guarda en pesos colombianos enteros: el COP no usa centavos.
model Tarifa {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  nombre       String
  valor        Int
  duracionDias Int
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())

  pagos Pago[]

  @@index([tenantId])
  @@map("tarifas")
}

// Pago de un estudiante registrado por el administrador. RF-19 · HU-19,
// RN-05 (vigencia) y RN-14 (pago válido). Nombre, valor y duración de la
// tarifa se copian al pago para que editar la tarifa después no cambie los
// pagos ya registrados (HU-18-CA-03). La membresía vigente del estudiante es
// el mayor vigenteHasta de sus pagos.
model Pago {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  estudianteId    String
  estudiante      User      @relation("PagosEstudiante", fields: [estudianteId], references: [id])
  tarifaId        String
  tarifa          Tarifa    @relation(fields: [tarifaId], references: [id])
  nombreTarifa    String
  monto           Int
  duracionDias    Int
  medio           MedioPago
  referencia      String?
  vigenteDesde    DateTime
  vigenteHasta    DateTime
  registradoPorId String
  registradoPor   User      @relation("PagosRegistradosPor", fields: [registradoPorId], references: [id])
  registradoEn    DateTime  @default(now())

  @@index([tenantId])
  @@index([estudianteId, vigenteHasta])
  @@map("pagos")
}

// Enlace para recuperar la contraseña. RF-05 · HU-05, RN-07: vence a los 30
// minutos y sirve una sola vez. Se guarda solo el hash SHA-256 del token: si
// alguien leyera la base de datos, no podría usar los enlaces pendientes.
model TokenRecuperacion {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("tokens_recuperacion")
}
