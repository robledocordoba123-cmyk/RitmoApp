# Copia este archivo a .env y ajusta si es necesario. .env nunca se sube a Git.

DATABASE_URL="postgresql://ritmoapp:ritmoapp_dev@localhost:5432/ritmoapp?schema=public"

# Secreto para firmar los tokens JWT (RF-02). En producción usa uno largo y aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

PORT=4000
