# Copia este archivo a .env y ajusta si es necesario. .env nunca se sube a Git.

DATABASE_URL="postgresql://ritmoapp:ritmoapp_dev@localhost:5432/ritmoapp?schema=public"

# Secreto para firmar los tokens JWT (RF-02). En producción usa uno largo y aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

PORT=4000

# Solo en producción: URL(s) del frontend que pueden llamar a la API,
# separadas por coma. Ej: https://ritmoapp.vercel.app
# CORS_ORIGIN=""
# NODE_ENV="production"

# Zona horaria de las academias (para "el día de la clase" en la asistencia).
# TZ_ACADEMIAS="America/Bogota"

# Recuperar contraseña (RF-05): URL del frontend para armar el enlace del correo.
# FRONTEND_URL="http://localhost:5173"

# Envío de correos. En producción se usa la API de Brevo, porque el plan
# gratuito de Render bloquea los puertos SMTP. En local sirve cualquiera de
# las dos; si no se configura ninguna, el correo se muestra en la consola.
# BREVO_API_KEY=""
#
# O por SMTP:
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# CORREO_REMITENTE="RitmoApp <no-responder@tu-dominio.com>"

# Cuántos proxies hay delante de la API (Render + Cloudflare). Sirve para que
# el límite de intentos vea la IP real del usuario. En producción, por defecto, 1.
# TRUST_PROXY=1
# Solo para ajustar TRUST_PROXY: activa GET /api/diagnostico/ip. Dejar apagado.
# DIAGNOSTICO_IP=false
